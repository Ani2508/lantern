# .env.example  -> copy to .env and fill ACCOUNT_ID only (contract 2.4, v1.2)
LANTERN_ENV=dev
LANTERN_MODE=local                  # local | aws
AWS_REGION=us-east-1
AWS_PROFILE=lantern
ACCOUNT_ID=000000000000
PREFIX=lantern-dev
DATA_BUCKET=lantern-dev-data-${ACCOUNT_ID}
WEB_BUCKET=lantern-dev-web-${ACCOUNT_ID}
TABLE_SITES=lantern-dev-sites
TABLE_INVENTORY=lantern-dev-inventory
TABLE_PLANS=lantern-dev-plans
TABLE_GATE_LOG=lantern-dev-gate-log
FN_SIMULATE=lantern-dev-simulate
FN_INGEST=lantern-dev-ingest
FN_PLAN=lantern-dev-plan
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:${ACCOUNT_ID}:lantern-dev-alerts
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=<exact model id copied from the Bedrock console>
BEDROCK_TIMEOUT_S=8
NOTIFY_ENABLED=true                 # v1.2: false during eval (no SMS, no fallback writes)
FORECASTER_MODEL_KEY=models/forecaster/v1/model.json
LOCAL_STORE_DIR=./.localstore
SIM_START_TS=2026-11-07T08:00:00Z
VITE_API_BASE_URL=http://localhost:8000/api   # CloudFront URL + /api in aws mode
VITE_USE_MOCKS=true
