LANTERN_ENV=dev
LANTERN_MODE=local                 # local | aws | memory
AWS_REGION=us-east-1
AWS_PROFILE=lantern
ACCOUNT_ID=000000000000
PREFIX=lantern-dev
DATA_BUCKET=lantern-dev-data-${ACCOUNT_ID}
WEB_BUCKET=lantern-dev-web-${ACCOUNT_ID}
TABLE_SITES=lantern-dev-sites
TABLE_INVENTORY=lantern-dev-inventory
TABLE_PLANS=lantern-dev-plans
TABLE_GATE_LOG=lantern-dev-gate-log
FN_SIMULATE=lantern-dev-simulate
FN_INGEST=lantern-dev-ingest
FN_PLAN=lantern-dev-plan
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:${ACCOUNT_ID}:lantern-dev-alerts
BEDROCK_ENABLED=false              # default false until verified (see extras/plans/05_aws_checklist.md)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_S=8
LLM_PROVIDER=ollama                # ollama (local laptop) | bedrock (AWS). BEDROCK_ENABLED=true turns LLM text on for either.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b             # best JSON follower of the pulled models; ~1 s warm, ~20 s cold load
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=30
OLLAMA_KEEP_ALIVE=1h
NOTIFY_ENABLED=false               # covers SNS + fallback page
FORECASTER_MODEL_KEY=models/forecaster/v1/model.json
FORECASTER_MODE=auto               # auto | heuristic
LOCAL_STORE_DIR=./.localstore
SIM_START_TS=2026-11-07T08:00:00Z
CORS_ORIGINS=http://localhost:5173 # comma-separated; add the CloudFront URL after deploy
FALLBACK_PUBLIC_URL=               # used in SMS text
FIELD_REPORT_MIN_CONFIDENCE=0.7
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCKS=true

# Engine and gate parameters (contract 2.8)
PLAN_HORIZON_H=72
QUANTILES=0.05,0.5,0.95
STALE_SIGMA_FRAC=0.35
STALE_QTY_FRAC=0.04
Z_90=1.645
MAX_TRANSFERS_PER_PLAN=10
SCOUT_MAX_PER_PLAN=2
REPLAN_EVERY_H=6
GATE_SOURCE_RESERVE_H=24
GATE_SOURCE_RESERVE_H_CRITICAL=72
GATE_DEST_MIN_H=12
GATE_MAX_TRANSFER_FRAC=0.5
GATE_SESSION_DRAW_FRAC=0.6
GATE_SESSION_REVIEW_FRAC=0.8
GATE_STALE_REVIEW_H=6
DATA_LOSS_LEVELS=0,10,20,30,40,50,60,70
EVAL_SEEDS=20
